# Caddy reverse proxy with automatic HTTPS (Let's Encrypt).
# DOMAIN is provided via the environment (see docker-compose.prod.yml).
# Point these DNS A-records at the VPS:  <domain>, api.<domain>, files.<domain>.
#
# SCOPE OF THIS FILE
# This is the ExtSync-only reference routing: what you need to reproduce ExtSync
# itself (website + API + artifact downloads) on a fresh host.
#
# The LIVE production host also serves several unrelated projects from the same
# Caddy instance, so its real Caddyfile is a superset of this one. The full,
# authoritative production routing is kept in the PRIVATE `extsync-ops` repo
# (infrastructure/caddy/Caddyfile.production) - it is not published here because
# it maps out internal hosts and services that are none of this repo's business.
# If you are changing production routing, that private copy is the source of
# truth; this file is the application-level reference.

# Shared hardening headers for every response Caddy serves.
(security_headers) {
	header {
		# Force HTTPS for two years, including subdomains.
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		# Don't let browsers MIME-sniff responses into a different content type.
		X-Content-Type-Options "nosniff"
		# These hosts are never meant to be framed.
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Don't advertise the server software.
		-Server
	}
}

# The website (Next.js standalone container, see the `web` service in
# docker-compose.prod.yml). It is served from this droplet - NOT from Vercel.
{$DOMAIN} {
	encode gzip zstd
	reverse_proxy web:3000
}

# API
api.{$DOMAIN} {
	import security_headers
	# Reject oversized bodies at the edge before the app buffers them into memory.
	# Non-exempt uploads are capped at 50MB by the API; this higher edge ceiling lets
	# UNLIMITED_UPLOAD_ALLOWLIST publishers ship large binary-bearing extensions and
	# bounds the absolute body the droplet will buffer into RAM (mind droplet memory).
	request_body {
		max_size 210MB
	}
	encode gzip zstd
	reverse_proxy api:8000
}

# Artifact downloads (MinIO). Used by the Agent and by the "download ZIP" button.
files.{$DOMAIN} {
	import security_headers
	encode gzip
	# Force the browser to SAVE artifact ZIPs ("Download ZIP" button) rather than
	# navigate to / preview them. The <a download> hint in the web app is ignored
	# because the file is cross-origin (files. vs the site), so the attachment
	# disposition must come from the server. Matches *.zip only (the artifacts);
	# icons/screenshots are images and are untouched, and the Agent downloads
	# programmatically so this header is a no-op for it.
	@zip path *.zip
	header @zip Content-Disposition attachment
	# Access log for artifact downloads, so raw downloads are auditable at the edge
	# and not only through the app-level counter. Rotation is bounded on purpose so
	# the log can never grow into a disk-space incident.
	log {
		output file /data/logs/files-access.log {
			roll_size 10mb
			roll_keep 5
			roll_keep_for 2160h
		}
		format json
	}
	reverse_proxy minio:9000
}
